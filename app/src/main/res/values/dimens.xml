<?xml version="1.0" encoding="utf-8"?>
<!--
    Metrics matched to the STB+ reference build:
    tight 4/8dp radii, 1dp focus strokes, 13/15/16/18sp type ramp,
    90x125dp posters and 42dp live rows.
-->
