<?xml version="1.0" encoding="utf-8"?>
<!--
    Theme matched to the STB+ reference build:
    Roboto family, radial slate gradient window, fullscreen, white-on-dark.
-->
<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/robotoregular</item>
        <item name="fontFamily">@font/robotoregular</item>
        <item name="android:textColor">@color/white</item>

        <item name="android:windowBackground">@drawable/background_main</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <item name="android:colorAccent">@color/accent</item>
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/sidelight</item>
        <item name="colorPrimaryDark">@color/side</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!--
        Splash window, matched to STB+ Theme.Qsmart.Splash: the same radial
        gradient the splash layout uses, so the window and the layout are
        indistinguishable and the hand-off is invisible.
    -->
    <style name="Theme.PlayBoxPro.Splash" parent="AppTheme">
        <item name="android:windowBackground">@drawable/background_main</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

    <style name="Theme.PlayBoxPro.Dialog" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowBackground">@color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:fontFamily">@font/robotoregular</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <!-- ============================================================
         Type scale — STB+ weights and sizes
         ============================================================ -->

    <!-- 18sp light gray, used for screen headers ("Select a profile") -->
    <style name="Text.Header" parent="">
        <item name="android:textSize">@dimen/sp_18</item>
        <item name="android:textColor">@color/light_gray</item>
        <item name="android:fontFamily">@font/robotolight</item>
    </style>

    <!-- 16sp regular white, used for nav items and account rows -->
    <style name="Text.Body" parent="">
        <item name="android:textSize">@dimen/sp_16</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/robotoregular</item>
    </style>

    <!-- 15sp light, used for live channel rows -->
    <style name="Text.Row" parent="">
        <item name="android:textSize">@dimen/sp_15</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/robotolight</item>
    </style>

    <!-- 13sp, used for card titles, footer info, profile names -->
    <style name="Text.Caption" parent="">
        <item name="android:textSize">@dimen/sp_13</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/robotoregular</item>
    </style>

    <!-- 13sp light gray secondary caption -->
    <style name="Text.Caption.Muted" parent="Text.Caption">
        <item name="android:textColor">@color/light_gray</item>
        <item name="android:fontFamily">@font/robotolight</item>
    </style>

    <!-- Orange value text: MAC address, App Key, metrics -->
    <style name="Text.Value" parent="">
        <item name="android:textSize">@dimen/sp_13</item>
        <item name="android:textColor">@color/yellow</item>
        <item name="android:fontFamily">@font/robotomedium</item>
    </style>

    <!-- Section / panel titles -->
    <style name="Text.Title" parent="">
        <item name="android:textSize">@dimen/sp_20</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:fontFamily">@font/robotomedium</item>
    </style>

    <!-- Account info rows (STB+ AccountInfoTextStyle) -->
    <style name="AccountInfoTextStyle">
        <item name="android:textSize">@dimen/sp_16</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:fontFamily">@font/robotoregular</item>
    </style>

    <!-- Drawer nav item text (STB+ NavigationDrawerStyle) -->
    <style name="NavigationDrawerStyle">
        <item name="android:textSize">@dimen/sp_16</item>
        <item name="android:textColor">@color/menu_item_color_state</item>
        <item name="android:fontFamily">@font/robotoregular</item>
        <item name="colorControlHighlight">@android:color/transparent</item>
        <item name="colorOnSurface">@android:color/transparent</item>
    </style>

    <!-- Rounded poster corners (STB+ roundedImageView) -->
    <style name="roundedImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_sm</item>
    </style>

    <!-- Detail page -->
    <style name="detailPosterShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="DetailPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">@drawable/bg_detail_btn</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="DetailPillText">
        <item name="android:maxLines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:fontFamily">@font/robotomedium</item>
        <item name="android:textColor">@color/detail_btn_text</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="DetailTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_detail_tab</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/robotomedium</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:textColor">@color/detail_tab_text</item>
        <item name="android:textSize">11sp</item>
    </style>
    <!-- Frosted-glass player controls -->
    <style name="GlassControl">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">@drawable/bg_glass_btn</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="tint">@color/glass_icon_tint</item>
    </style>

    <style name="GlassRoundButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:padding">9dp</item>
        <item name="android:background">@drawable/bg_glass_round</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="tint">@color/glass_icon_tint</item>
    </style>

    <style name="GlassBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:background">@drawable/bg_glass_badge</item>
        <item name="android:fontFamily">@font/robotomedium</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">11sp</item>
    </style>
    <style name="GlassNavItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">62dp</item>
        <item name="android:minWidth">70dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:background">@drawable/bg_glass_btn</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="GlassNavIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:contentDescription">@null</item>
        <item name="tint">@color/glass_icon_tint</item>
    </style>

    <style name="GlassNavLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:fontFamily">@font/robotoregular</item>
        <item name="android:textColor">@color/glass_icon_tint</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Search tiles -->
    <style name="SearchTileBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:background">@drawable/bg_search2_badge</item>
        <item name="android:fontFamily">@font/robotomedium</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">9.5sp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="SearchTab">
        <item name="android:layout_width">190dp</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">@drawable/bg_search2_tab</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:fontFamily">@font/robotoregular</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:textColor">#E6FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="drawableTint">#E6FFFFFF</item>
    </style>

    <!-- Legal terms page -->
    <style name="TermsBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/robotoregular</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">#F2FFFFFF</item>
        <item name="android:textSize">14.5sp</item>
    </style>

    <style name="TermsBullet" parent="TermsBody">
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:drawableStart">@drawable/bullet_dot</item>
        <item name="android:drawablePadding">12dp</item>
    </style>

    <style name="TermsFooter">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/robotoregular</item>
        <item name="android:textColor">#CCFFFFFF</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="TermsLink" parent="TermsFooter">
        <item name="android:background">@drawable/bg_terms_link</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:textColor">#FF5CE1E6</item>
    </style>

    <!-- Subscription notices -->
    <style name="NoticeDetail">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:fontFamily">@font/robotoregular</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="NoticeButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">150dp</item>
        <item name="android:background">@drawable/bg_notice_button</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">@font/robotomedium</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">26dp</item>
        <item name="android:paddingEnd">26dp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
