<?xml version="1.0" encoding="utf-8"?>
<!-- Glass buttons: bare at rest, a bright frosted tile under the remote,
     and a blue tile for the section currently on screen. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><corners android:radius="12dp" /><solid android:color="#59FFFFFF" /><stroke android:width="1.5dp" android:color="#CCFFFFFF" /></shape>
    </item>
    <item android:state_selected="true">
        <shape><corners android:radius="12dp" /><solid android:color="#663D8BFF" /><stroke android:width="1dp" android:color="#AA5AA2FF" /></shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
