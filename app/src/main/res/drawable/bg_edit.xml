<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/focus_fill" />
            <corners android:radius="@dimen/radius_md" />
            <stroke android:width="@dimen/focus_stroke" android:color="@color/white" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/info_surface" />
            <corners android:radius="@dimen/radius_md" />
            <stroke android:width="1dp" android:color="@color/surface_border" />
        </shape>
    </item>
</selector>
