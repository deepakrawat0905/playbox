<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary count text: darkens when its row fills white on selection -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:color="#8A000000" />
    <item android:state_checked="true" android:color="#8A000000" />
    <item android:color="@color/text_dim" />
</selector>
