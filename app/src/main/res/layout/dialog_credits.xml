<?xml version="1.0" encoding="utf-8"?>
<!--
    Credits, matched to STB+ dialog_credits: 40dp mark, 20sp heading, a 327dp
    scroll of 14sp section titles over 12sp bodies, and a white CLOSE pill.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_gravity="start|top"
        android:layout_margin="40dp"
        android:clickable="true"
        android:focusable="true"
        android:padding="10dp"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/light_gray" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:minWidth="750dp"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:src="@drawable/ic_attribution"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/robotolight"
            android:text="Credits &amp; Open Source"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="327dp"
            android:layout_marginTop="16dp"
            android:fadeScrollbars="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Media &amp; Playback"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:lineSpacingExtra="2dp"
                    android:text="• Media3 / ExoPlayer (Google): extensible media playback."
                    android:textColor="#FFCCCCCC"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Networking &amp; Data"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:lineSpacingExtra="2dp"
                    android:text="• OkHttp (Square): HTTP client.\n• Gson (Google): JSON serialisation."
                    android:textColor="#FFCCCCCC"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="UI &amp; Utilities"
                    android:textColor="@color/white"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="• Glide (Bumptech): image loading and caching.\n• ZXing (Google): QR code generation.\n• Roboto (Google): type family, Apache 2.0."
                    android:textColor="#FFCCCCCC"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/creditsDevice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#FFCCCCCC"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_btn_white_pill"
            android:focusable="true"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:stateListAnimator="@null"
            android:text="CLOSE"
            android:textColor="@color/black"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
