<?xml version="1.0" encoding="utf-8"?>
<!-- STB+ item_trailer: 200x115 thumbnail with a play roundel, site (10sp bold) and name (12sp) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trailerRoot"
    android:layout_width="200dp"
    android:layout_height="160dp"
    android:layout_marginEnd="10dp"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:duplicateParentState="true"
        android:gravity="top"
        android:orientation="vertical"
        android:padding="4dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="115dp"
            android:background="@drawable/stb_nested_selector"
            android:duplicateParentState="true"
            android:padding="2dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivThumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="2dp"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/roundedImageView" />

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center"
                android:background="@drawable/circular_progress"
                android:contentDescription="@null"
                android:padding="7dp"
                android:src="@drawable/stb_icon_play_white" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvTrailerSite"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            android:textColor="@color/light_gray"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTrailerName"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:maxLines="1"
            android:textColor="@color/light_gray"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
