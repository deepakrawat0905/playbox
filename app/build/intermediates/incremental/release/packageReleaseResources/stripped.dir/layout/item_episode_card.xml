<?xml version="1.0" encoding="utf-8"?>
<!--
    STB+ item_episode: a 230x120 rounded still with the resume bar along its
    bottom and a play glyph centred on it, the episode number chip top-left,
    then the title (13sp light, marquee) and a four-line synopsis at 30%
    alpha to the right. Rows are 10dp apart, 20dp in from the left.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/episodeRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/transparent"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:id="@+id/epStillWrap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/stb_nested_selector"
        android:duplicateParentState="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/epStill"
            android:layout_width="230dp"
            android:layout_height="120dp"
            android:elevation="1dp"
            android:padding="2dp"
            android:scaleType="fitXY"
            app:shapeAppearanceOverlay="@style/roundedImageView" />

        <ProgressBar
            android:id="@+id/epProgress"
            style="?android:progressBarStyleHorizontal"
            android:layout_width="220dp"
            android:layout_height="5dp"
            android:layout_gravity="center|bottom"
            android:layout_marginBottom="10dp"
            android:background="@drawable/stb_round_corner_meta_info"
            android:elevation="2dp"
            android:max="100"
            android:padding="1dp"
            android:progressDrawable="@drawable/rounded_white_progress"
            android:visibility="gone" />
    </FrameLayout>

    <ImageView
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:contentDescription="@null"
        android:src="@drawable/stb_icon_play_white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/epStillWrap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/white" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/epTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="7dp"
        android:layout_marginTop="7dp"
        android:background="@drawable/round_corner_series_info_gray"
        android:fontFamily="@font/robotoregular"
        android:padding="3dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_10"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/epTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="22dp"
        android:duplicateParentState="true"
        android:ellipsize="marquee"
        android:fontFamily="@font/robotolight"
        android:marqueeRepeatLimit="marquee_forever"
        android:paddingTop="20dp"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/epStillWrap"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/epPlot"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:alpha="0.3"
        android:fontFamily="@font/robotolight"
        android:letterSpacing="0.03"
        android:lineSpacingExtra="2sp"
        android:maxLines="4"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:textColor="@color/white"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/epStillWrap"
        app:layout_constraintTop_toBottomOf="@id/epTitle" />

    <TextView
        android:id="@+id/epDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
