<?xml version="1.0" encoding="utf-8"?>
<!-- One search result: artwork, quality / country badges, name at the foot -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tileRoot"
    android:layout_width="112dp"
    android:layout_height="128dp"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:background="@drawable/bg_search2_tile"
    android:clickable="true"
    android:focusable="true"
    android:foreground="@drawable/fg_search2_tile">

    <ImageView
        android:id="@+id/tileImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null" />

    <View
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_search2_tile_scrim" />

    <TextView
        android:id="@+id/tileBadgeLeft"
        style="@style/SearchTileBadge"
        android:layout_gravity="top|start" />

    <TextView
        android:id="@+id/tileBadgeRight"
        style="@style/SearchTileBadge"
        android:layout_gravity="top|end" />

    <TextView
        android:id="@+id/tileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:ellipsize="end"
        android:fontFamily="@font/robotomedium"
        android:gravity="center"
        android:maxLines="2"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp"
        android:shadowColor="#CC000000"
        android:shadowRadius="3"
        android:textColor="@color/white"
        android:textSize="12.5sp" />
</FrameLayout>
