<?xml version="1.0" encoding="utf-8"?>
<!--
    Movie / episode player. The video fills the window; the controls sit on
    one frosted-glass panel along the bottom:
      title and elapsed / total time, format badges on the right
      the seek bar
      "Now Playing" on the left, transport controls in the middle,
      profile, player settings and the clock on the right.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/exoPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:resize_mode="fit"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <ProgressBar
        android:id="@+id/playerBuffering"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="@color/white"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/playError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/robotoregular"
        android:gravity="center"
        android:text="Broadcast Source Offline"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_15"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ============================================================
         OSD
         ============================================================ -->
    <FrameLayout
        android:id="@+id/playerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_glass_scrim" />

        <LinearLayout
            android:id="@+id/osdPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="36dp"
            android:layout_marginEnd="36dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_glass_panel"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="18dp"
            android:paddingEnd="28dp"
            android:paddingBottom="12dp">

            <!-- Title + time, badges on the right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/osdTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/robotomedium"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/osdTimeElapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/robotoregular"
                        android:text="00:00 / 00:00"
                        android:textColor="#E6FFFFFF"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/osdResolution"
                    style="@style/GlassBadge"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/osdCcBadge"
                    style="@style/GlassBadge"
                    android:text="CC"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/osdKindLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginBottom="2dp"
                    android:fontFamily="@font/robotoregular"
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Seek bar -->
            <FrameLayout
                android:id="@+id/osdSeekRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <androidx.appcompat.widget.AppCompatSeekBar
                    android:id="@+id/osdSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:background="@null"
                    android:max="1000"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:progressDrawable="@drawable/progress_glass"
                    android:splitTrack="false"
                    android:thumb="@drawable/thumb_glass"
                    android:thumbOffset="2dp" />
            </FrameLayout>

            <!-- Now Playing | transport | profile, settings, clock -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_glass_film"
                        app:tint="#E6FFFFFF" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/robotoregular"
                            android:text="Now Playing:"
                            android:textColor="#CCFFFFFF"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/osdNowPlaying"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/robotomedium"
                            android:maxLines="1"
                            android:textAllCaps="true"
                            android:textColor="@color/white"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnPrevEpisode"
                        style="@style/GlassControl"
                        android:contentDescription="Previous"
                        android:src="@drawable/ic_glass_prev" />

                    <ImageView
                        android:id="@+id/btnRewind30"
                        style="@style/GlassControl"
                        android:contentDescription="Rewind"
                        android:src="@drawable/ic_glass_rewind" />

                    <!-- Space above matches the label below, so the button sits
                         on the same centre line as the other controls. -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <Space
                            android:layout_width="1dp"
                            android:layout_height="12dp" />

                        <ImageView
                            android:id="@+id/btnPlayPause"
                            style="@style/GlassControl"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:contentDescription="Play / Pause"
                            android:padding="10dp"
                            android:src="@drawable/ic_glass_pause" />

                        <TextView
                            android:id="@+id/osdPlayLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="12dp"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/robotomedium"
                            android:letterSpacing="0.06"
                            android:text="PAUSE"
                            android:textColor="#E6FFFFFF"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnForward30"
                        style="@style/GlassControl"
                        android:contentDescription="Forward"
                        android:src="@drawable/ic_glass_forward" />

                    <ImageView
                        android:id="@+id/btnNextEpisode"
                        style="@style/GlassControl"
                        android:contentDescription="Next"
                        android:src="@drawable/ic_glass_next" />

                    <ImageView
                        android:id="@+id/btnSubtitles"
                        style="@style/GlassControl"
                        android:layout_marginStart="10dp"
                        android:contentDescription="Subtitles"
                        android:src="@drawable/ic_glass_subtitles" />
                </LinearLayout>

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/osdProfilePill"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_glass_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingEnd="14dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_glass_person"
                            app:tint="#E6FFFFFF" />

                        <TextView
                            android:id="@+id/osdProfileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/robotoregular"
                            android:maxWidth="140dp"
                            android:maxLines="1"
                            android:textColor="@color/white"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnPlayerSettings"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_glass_round"
                        android:contentDescription="Player settings"
                        android:focusable="true"
                        android:padding="9dp"
                        android:src="@drawable/ic_glass_settings"
                        app:tint="@color/glass_icon_tint" />

                    <TextView
                        android:id="@+id/osdClock"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_glass_pill"
                        android:fontFamily="@font/robotoregular"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textColor="@color/white"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
