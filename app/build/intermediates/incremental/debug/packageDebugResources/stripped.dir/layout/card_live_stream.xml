<?xml version="1.0" encoding="utf-8"?>
<!--
    Live search result matched to STB+ card_live_stream:
    175dp card, channel name and number on the top row, then the EPG block -
    category, programme, time, description - with the channel logo at the end.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/liveCardRoot"
    android:layout_width="match_parent"
    android:layout_height="175dp"
    android:layout_margin="10dp"
    android:background="@drawable/bg_search_card"
    android:clickable="true"
    android:elevation="4dp"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Title row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/liveTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/robotolight"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_13" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/liveNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_12" />
    </LinearLayout>

    <!-- EPG block -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_gravity="bottom"
        android:gravity="bottom"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/epgCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.3"
                    android:textColor="@color/white"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/epgInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                    android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_13" />

            <TextView
                android:id="@+id/epgTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                    android:textColor="@color/white"
                android:textSize="9sp" />

            <TextView
                android:id="@+id/epgDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:alpha="0.3"
                    android:maxLines="3"
                android:textColor="@color/white"
                android:textSize="10sp" />
        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/liveLogo"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginStart="20dp"
            android:scaleType="fitCenter" />
    </LinearLayout>
</LinearLayout>
