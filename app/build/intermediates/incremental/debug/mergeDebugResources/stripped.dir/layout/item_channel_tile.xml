<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/channelTileRoot"
    android:layout_width="208dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true"
    android:background="@android:color/transparent"
    android:padding="4dp"
    android:layout_margin="6dp"
    android:clipChildren="false">

    <!-- 16:9 Channel Art Container with Focus Ring -->
    <FrameLayout
        android:id="@+id/channelTileArt"
        android:layout_width="match_parent"
        android:layout_height="117dp"
        android:background="@drawable/bg_art_selector"
        android:duplicateParentState="true"
        android:elevation="4dp">

        <!-- Channel Logo Centered with padding -->
        <ImageView
            android:id="@+id/tileLogo"
            android:layout_width="100dp"
            android:layout_height="68dp"
            android:layout_gravity="center"
            android:scaleType="fitCenter" />

        <!-- LIVE Badge at Top-Left -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="#D904060A"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp">

            <View
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/live" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="LIVE"
                android:textColor="@color/live"
                android:textSize="10sp"
                android:fontFamily="@font/robotomedium"
                android:letterSpacing="0.08" />
        </LinearLayout>
    </FrameLayout>

    <!-- Channel Name -->
    <TextView
        android:id="@+id/tileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textColor="@color/text"
        android:textSize="15sp"
        android:fontFamily="@font/robotomedium"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Category Subtitle -->
    <TextView
        android:id="@+id/tileCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:textColor="@color/text_dim"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
