<?xml version="1.0" encoding="utf-8"?>
<!--
    Movie / series detail page.

    Full-bleed backdrop darkened from the left and the bottom; the title in
    large capitals top-left with a genre / year line under it; the poster on
    the left and, beside it, the rating + runtime line in yellow, a short
    synopsis, the action pills (PLAY NOW in white, the rest frosted grey),
    the Summary block with the cast line, and the RELATED FEATURES /
    CAST & CREW tabs. The chosen tab's rail runs along the bottom.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <ImageView
        android:id="@+id/detailBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:focusable="false"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/detail_scrim_left" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/detail_scrim_bottom" />

    <!-- Title -->
    <TextView
        android:id="@+id/detailTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="40dp"
        android:ellipsize="end"
        android:fontFamily="@font/robotoregular"
        android:maxLines="1"
        android:shadowColor="#CC000000"
        android:shadowRadius="6"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Genre / year line under the title -->
    <TextView
        android:id="@+id/detailTagline"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/robotomedium"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="#CCFFFFFF"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="@id/detailTitle"
        app:layout_constraintStart_toStartOf="@id/detailTitle"
        app:layout_constraintTop_toBottomOf="@id/detailTitle" />

    <!-- Poster -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/detailPoster"
        android:layout_width="150dp"
        android:layout_height="222dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="12dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/detailTagline"
        app:shapeAppearanceOverlay="@style/detailPosterShape" />

    <!-- Right-hand column -->
    <LinearLayout
        android:id="@+id/detailColumn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="30dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/detailPoster"
        app:layout_constraintTop_toTopOf="@id/detailPoster">

        <TextView
            android:id="@+id/detailRatingLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/robotomedium"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/detailShortPlot"
            android:layout_width="wrap_content"
            android:maxWidth="600dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/robotoregular"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:textColor="#E6FFFFFF"
            android:textSize="11sp" />

        <!-- Action pills -->
        <LinearLayout
            android:id="@+id/detailButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnDetailPlay"
                style="@style/DetailPill"
                android:background="@drawable/bg_detail_btn_primary"
                android:nextFocusDown="@id/tabRelated">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_play_arrow"
                    app:tint="@color/black" />

                <TextView
                    android:id="@+id/btnDetailPlayText"
                    style="@style/DetailPillText"
                    android:text="PLAY NOW"
                    android:textColor="@color/black" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnDetailStartOver"
                style="@style/DetailPill"
                android:visibility="gone">

                <TextView
                    style="@style/DetailPillText"
                    android:text="START OVER" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnDetailEpisodes"
                style="@style/DetailPill"
                android:visibility="gone">

                <TextView
                    style="@style/DetailPillText"
                    android:text="EPISODES" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnDetailTrailer"
                style="@style/DetailPill">

                <TextView
                    style="@style/DetailPillText"
                    android:text="WATCH TRAILER" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnDetailFavorite"
                style="@style/DetailPill">

                <ImageView
                    android:id="@+id/btnDetailFavoriteIcon"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@null"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_heart_outline"
                    app:tint="@color/detail_btn_text" />

                <TextView
                    android:id="@+id/btnDetailFavoriteText"
                    style="@style/DetailPillText"
                    android:text="ADD TO FAVORITES" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnDetailMoreInfo"
                style="@style/DetailPill">

                <TextView
                    style="@style/DetailPillText"
                    android:text="MORE INFO" />
            </LinearLayout>
        </LinearLayout>

        <!-- Summary -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/robotomedium"
            android:text="Summary"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/detailPlot"
            android:layout_width="wrap_content"
            android:maxWidth="600dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="@font/robotoregular"
            android:lineSpacingExtra="1dp"
            android:maxLines="3"
            android:textColor="#D9FFFFFF"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/detailCastLine"
            android:layout_width="wrap_content"
            android:maxWidth="600dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="@font/robotoregular"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />

        <!-- Tabs -->
        <LinearLayout
            android:id="@+id/detailTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabRelated"
                style="@style/DetailTab"
                android:nextFocusUp="@id/btnDetailPlay"
                android:text="RELATED FEATURES" />

            <TextView
                android:id="@+id/tabCast"
                style="@style/DetailTab"
                android:layout_marginStart="18dp"
                android:nextFocusUp="@id/btnDetailPlay"
                android:text="CAST &amp; CREW" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom rail -->
    <TextView
        android:id="@+id/detailRailLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/robotomedium"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/detailRail"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/detailRail"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginBottom="6dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:overScrollMode="never"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:scrollbars="none"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/detailRailEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:text="Nothing to show"
        android:textColor="#99FFFFFF"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/detailRail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/detailRail" />

</androidx.constraintlayout.widget.ConstraintLayout>
