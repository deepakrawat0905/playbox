<?xml version="1.0" encoding="utf-8"?>
<!--
    STB+ item_epg_now_playing: start time (16sp light, 22dp in), a 22dp
    archive marker 12dp after it, the LIVE badge 20dp after that, the title
    (16sp light) and the synopsis (15sp light grey, up to 7 lines) under it.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/epgTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:fontFamily="@font/robotolight"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_16"
        app:layout_constraintBottom_toBottomOf="@id/epgProgTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/epgProgTitle" />

    <ImageView
        android:id="@+id/epgArchiveIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="12dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_autoplay"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/epgTime"
        app:layout_constraintStart_toEndOf="@id/epgTime"
        app:layout_constraintTop_toTopOf="@id/epgTime" />

    <ImageView
        android:id="@+id/epgLiveBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:contentDescription="@null"
        android:src="@drawable/stb_ic_live_badge"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/epgProgTitle"
        app:layout_constraintStart_toEndOf="@id/epgArchiveIcon"
        app:layout_constraintTop_toTopOf="@id/epgProgTitle" />

    <TextView
        android:id="@+id/epgProgTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:ellipsize="end"
        android:fontFamily="@font/robotolight"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="@dimen/sp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/epgLiveBadge"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/epgProgDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="22dp"
        android:letterSpacing="0.02"
        android:lineSpacingExtra="2dp"
        android:maxLines="7"
        android:paddingBottom="4dp"
        android:textColor="@color/light_gray"
        android:textSize="@dimen/sp_15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/epgProgTitle"
        app:layout_constraintTop_toBottomOf="@id/epgProgTitle" />
</androidx.constraintlayout.widget.ConstraintLayout>
