<?xml version="1.0" encoding="utf-8"?>
<!--
    Profile card matched to STB+ item_profile:
    75dp rounded avatar inside a focus ring, active check badge top-end,
    13sp name chip on a faint wash, and a refresh / info button pair below.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:background="@null"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:descendantFocusability="afterDescendants"
    android:gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/containerProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:gravity="center"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/profile_selector"
            android:duplicateParentState="true"
            android:padding="2dp">

            <androidx.cardview.widget.CardView
                android:layout_width="@dimen/profile_avatar"
                android:layout_height="@dimen/profile_avatar"
                android:elevation="3dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/ivIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="7dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/stb_icon_user" />
            </androidx.cardview.widget.CardView>

            <!-- Active playlist check badge -->
            <ImageView
                android:id="@+id/ivActiveCheck"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="1dp"
                android:src="@drawable/stb_check"
                android:visibility="gone"
                app:tint="@color/light_gray" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvProfileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/bg_info_item"
            android:ellipsize="end"
            android:fontFamily="@font/robotolight"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="25dp"
            android:paddingTop="3dp"
            android:paddingEnd="25dp"
            android:paddingBottom="3dp"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_13" />
    </LinearLayout>

    <!-- Per-profile options -->
    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivRefresh"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginEnd="2dp"
            android:background="@drawable/profile_selector"
            android:clickable="true"
            android:focusable="true"
            android:padding="5dp"
            android:src="@drawable/stb_refresh"
            app:tint="@color/light_gray" />

        <ImageView
            android:id="@+id/ivInfo"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/profile_selector"
            android:clickable="true"
            android:focusable="true"
            android:padding="5dp"
            android:src="@drawable/stb_info"
            app:tint="@color/light_gray" />
    </LinearLayout>
</LinearLayout>
