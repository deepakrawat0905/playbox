<?xml version="1.0" encoding="utf-8"?>
<!-- Icon tint that flips to black on a white-filled selected row -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="@color/black" />
    <item android:state_selected="true" android:color="@color/black" />
    <item android:state_checked="true" android:color="@color/black" />
    <item android:color="@color/white" />
</selector>
