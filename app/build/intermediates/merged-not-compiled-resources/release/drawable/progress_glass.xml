<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical|fill_horizontal" android:height="4dp">
        <shape><corners android:radius="2dp" /><solid android:color="#59FFFFFF" /></shape>
    </item>
    <item android:id="@android:id/secondaryProgress" android:gravity="center_vertical|fill_horizontal" android:height="4dp">
        <clip><shape><corners android:radius="2dp" /><solid android:color="#80FFFFFF" /></shape></clip>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical|fill_horizontal" android:height="4dp">
        <clip><shape><corners android:radius="2dp" /><solid android:color="#FFFFFFFF" /></shape></clip>
    </item>
</layer-list>
