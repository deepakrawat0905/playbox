<?xml version="1.0" encoding="utf-8"?>
<!-- STB+ EPG progress bar -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape>
            <size android:height="4dp" />
            <corners android:radius="10dp" />
            <solid android:color="#40FFFFFF" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress" android:gravity="center_vertical">
        <scale android:scaleWidth="100%">
            <shape>
                <size android:height="4dp" />
                <corners android:radius="10dp" />
                <solid android:color="#80FFFFFF" />
            </shape>
        </scale>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <scale android:scaleWidth="100%">
            <shape>
                <size android:height="4dp" />
                <corners android:radius="10dp" />
                <solid android:color="@color/white" />
            </shape>
        </scale>
    </item>
</layer-list>
