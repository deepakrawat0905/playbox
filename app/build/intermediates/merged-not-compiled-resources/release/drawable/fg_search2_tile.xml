<?xml version="1.0" encoding="utf-8"?>
<!-- Tile outline: a hairline at rest, a bright blue-white ring when focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><corners android:radius="10dp" /><stroke android:width="3dp" android:color="#FFBFE0FF" /></shape>
    </item>
    <item>
        <shape><corners android:radius="10dp" /><stroke android:width="1dp" android:color="#33FFFFFF" /></shape>
    </item>
</selector>
